{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule",
  "type": "object",
  "properties": {
    "type": { "type": "string" },
    "value": { "type": "string" },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expiryDate": { "type": "string", "format": "date" },
    "usageLimit": { "type": "integer" },
    "stackable": { "type": "boolean" }
  },
  "required": ["type", "value", "conditions"]
}
